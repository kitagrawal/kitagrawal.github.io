// Cloudflare Worker config for appliedailetter.com. Deployed by Workers Builds (`npx wrangler deploy`) on push to main.
//
// Secrets (set with `wrangler secret put <NAME>`; values are never committed):
//   CANCEL_API_URL
//   CANCEL_SHARED_SECRET
//   SUBSCRIBE_URL
{
  "name": "appliedailetter",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "CANCEL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "appliedailetter.com", "custom_domain": true },
    { "pattern": "www.appliedailetter.com", "custom_domain": true }
  ]
}
