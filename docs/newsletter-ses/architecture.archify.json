  "cards": [
    {
      "dot": "violet",
      "title": "Stripe owns state",
      "items": [
        "The table is built from signed webhook events only; username holds the Stripe customer id",
        "AWS holds no Stripe API key: nothing in AWS can read or change Stripe",
        "Each half of a row keeps its event time, so repeated or out-of-order events are harmless"
      ]
    },
    {
      "dot": "emerald",
      "title": "Endpoints, built",
      "items": [
        "StripeSync: the one Stripe webhook (checkout, subscription and customer events)",
        "UnsubscribeUser: POST /unsubscribe and /unsubscribe/one-click, 2 req/s",
        "Code in newsletter/, pushed with newsletter/deploy.sh"
      ]
    },
    {
      "dot": "amber",
      "title": "Unsubscribe",
      "items": [
        "Letter link opens the hidden unsubscribe.html with ?c=<customer id>&t=<HMAC token>",
        "Reader types their email; UnsubscribeUser checks the token, then the email against the DynamoDB row",
        "Letters stop at once (email_opt_out); SNS emails the owner while the plan still bills",
        "Owner cancels in the Stripe Dashboard within 2 days; the webhook records it"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets in SSM (us-east-2)",
      "items": [
        "StripeSync webhook signing secret and the unsubscribe HMAC key",
        "Each Lambda can read only the parameters it uses",
        "No Stripe API key anywhere; nothing secret in the repo or config.js"
      ]
    },
    {
      "dot": "slate",
      "title": "Planned, not built",
      "items": [
        "S3 issues bucket, send-issue Lambda, welcome and goodbye emails",
        "SES is in the sandbox and needs a custom sending domain"
      ]
    }
  ]
