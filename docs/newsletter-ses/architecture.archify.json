  "cards": [
    {
      "dot": "violet",
      "title": "Stripe owns state",
      "items": [
        "The table is built from signed webhook events only; username holds the Stripe customer id",
        "StripeSync uses no Stripe key; the one restricted key (Subscriptions: Write only) belongs to CancelPlan, which reads the table and never writes it",
        "Each half of a row keeps its event time, so repeated or out-of-order events are harmless"
      ]
    },
    {
      "dot": "emerald",
      "title": "Endpoints, built",
      "items": [
        "StripeSync: the one Stripe webhook (checkout, subscription and customer events)",
        "CancelPlan: POST /cancel, 2 req/s",
        "Code in newsletter/, pushed with newsletter/deploy.sh"
      ]
    },
    {
      "dot": "amber",
      "title": "Cancel",
      "items": [
        "The Cancel link at the bottom of every letter opens the hidden cancel page with ?c=<customer id>; the id alone is the proof",
        "Reader presses Confirm; CancelPlan reads the DynamoDB row and sets cancel_at_period_end in Stripe",
        "Letters continue until the paid period ends; the webhook records the change",
        "Letters carry no List-Unsubscribe headers"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets in SSM (us-east-2)",
      "items": [
        "StripeSync webhook signing secret",
        "Each Lambda can read only the parameters it uses",
        "The one Stripe key (rk_, Subscriptions: Write) is in Secrets Manager; nothing secret in the repo or config.js"
      ]
    },
    {
      "dot": "slate",
      "title": "Planned, not built",
      "items": [
        "S3 issues bucket, send-issue Lambda, welcome and goodbye emails",
        "SES is in the sandbox and needs a custom sending domain"
      ]
    }
  ]
